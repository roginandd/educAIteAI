NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/educaiteai
GOOGLE_GENAI_API_KEY=replace-me
GOOGLE_GENAI_USE_VERTEXAI=false
# Required only when GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_ADK_APP_NAME=educAIteAI
EDUCAITE_API_BASE_URL=URL
GOOGLE_GENAI_MODEL=GEMINI_MODEL
GOOGLE_GENAI_FLASH_MODEL=gemini-2.5-flash
GOOGLE_GENAI_SMART_QUIZ_MODEL=GEMINI_SMART_QUIZ_MODEL
GOOGLE_GENAI_SMART_QUIZ_GENERATION_MODEL=
GOOGLE_GENAI_SMART_QUIZ_PDF_MODEL=
GOOGLE_GENAI_RESUME_MODEL=GEMINI_RESUME_MODEL
GOOGLE_GENAI_NOTE_PDF_MODEL=GEMINI_NOTE_PDF_MODEL
JUDGE0_API_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=<your-judge0-token>
JUDGE0_API_KEY_HEADER=X-Auth-Token
